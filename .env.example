# Local development only.
# Copy this file to .env before starting Docker Compose.
# .env is gitignored. Do not put real secrets in .env.example.

# PostgreSQL
POSTGRES_DB=smartwatch
POSTGRES_USER=smartwatch
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379

# Backend process environment. Spring Boot does not load .env by itself.
DATABASE_URL=jdbc:postgresql://localhost:5432/smartwatch
DATABASE_USERNAME=smartwatch
DATABASE_PASSWORD=change-me-local-only
SERVER_PORT=8080

# HMAC-SHA256 key for access tokens. At least 32 bytes. Replace this placeholder locally.
JWT_SECRET=change-me-to-a-long-random-development-secret
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# Browser origin allowed to call the API directly. The Next.js dev server proxies /api by default.
CORS_ALLOWED_ORIGINS=http://localhost:3000
