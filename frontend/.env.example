# Browser-visible API origin. Leave empty so the browser calls this Next.js app at /api.
# The refresh cookie then stays on the frontend origin. Do not put backend secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=

# Backend origin used by the Next.js /api rewrite. Read when the frontend is built.
# Not exposed to the browser. Point this at the API service in production.
API_PROXY_TARGET=http://localhost:8080
