# Backend process environment.
# Spring Boot does not load this file automatically.
# Export the variables in your shell, or source the repository root .env.
# Placeholders only. Never commit a real password, JWT secret, or access token.

DATABASE_URL=jdbc:postgresql://localhost:5432/smartwatch
DATABASE_USERNAME=smartwatch
DATABASE_PASSWORD=change-me-local-only
SERVER_PORT=8080

# HMAC-SHA256 key for access tokens. At least 32 bytes. Replace this placeholder locally.
JWT_SECRET=change-me-to-a-long-random-development-secret
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# Frontend origin. The Next.js rewrite forwards the browser Origin, so this must match the site.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set true when the site is served over HTTPS.
COOKIE_SECURE=false

# Keep false until an Upstox app is approved. A true value with a blank token prevents startup.
UPSTOX_ENABLED=false
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_ACCESS_TOKEN=
UPSTOX_STALE_AFTER=PT15M
